{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landarover-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
